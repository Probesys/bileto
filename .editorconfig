# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[tests/fixtures/emails/**/*.eml]
# RFC 3676 flowed text and signature separators contain significant trailing spaces.
trim_trailing_whitespace = false
